{
  "vendor": {
    "plugins/modern-hotel-booking": "1.0"
  },
  "admin-config": {
    "mhbo-email-template": {
      "pages": {
        "post.php": "post_type=mhbo_email_template",
        "post-new.php": "post_type=mhbo_email_template"
      },
      "anchors": {
        "post": { "where": "before" }
      },
      "forms": {
        "post": {
          "fields": {
            "title": { "jquery": "#title" },
            "content": { "jquery": "#content" }
          }
        }
      }
    },
    "mhbo-settings": {
      "pages": {
        "admin.php": "page=mhbo-settings"
      },
      "forms": {
        "form": {
          "fields": {
            "mhbo_hotel_guest_instructions": {},
            "mhbo_confirmation_btn_text": {},
            "mhbo_service_fee_label": {},
            "mhbo_onsite_instructions": {},
            "company_name": {},
            "address_line_1": {},
            "address_line_2": {},
            "city": {},
            "state": {},
            "country": {},
            "contact_name": {},
            "wa_default_msg": {},
            "wa_button_text": {},
            "bank_name": {},
            "account_name": {},
            "branch_address": {},
            "bank_instructions": {},
            "revolut_name": {},
            "rev_instructions": {}
          }
        }
      }
    },
    "mhbo-ai-settings": {
      "pages": {
        "admin.php": "page=mhbo-ai-concierge"
      },
      "forms": {
        "form": {
          "fields": {
            "mhbo_ai_persona_name": {},
            "mhbo_ai_welcome_message": {},
            "mhbo_ai_custom_instructions": {},
            "mhbo_ai_local_guide": {}
          }
        }
      }
    }
  },
  "front-config": {
    "all-pages": {
      "filters": {
        "text": {
          "mhbo_i18n_decode": "20"
        }
      }
    }
  }
}
